    function startLiveHistoryListener() {
        if(!currentUser) return;
        
        if(historyListenerUnsubscribe) {
            historyListenerUnsubscribe();
        }

        const container = document.getElementById('history-container');
        container.innerHTML = '<div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading live keys...</p></div>';

        const purchasesRef = ref(db, `purchases/${currentUser.uid}`);
        historyListenerUnsubscribe = onValue(purchasesRef, (snapshot) => {
            container.innerHTML = '';
            
            if(!snapshot.exists()) {
                container.innerHTML = '<div class="empty-state"><i class="fas fa-key"></i><p>No purchases yet</p></div>';
                return;
            }
            
            const purchases = [];
            snapshot.forEach(child => {
                purchases.push({ id: child.key, ...child.val() });
            });
            
            purchases.sort((a,b) => {
                const dateA = a.date?.toDate ? a.date.toDate() : new Date(a.date);
                const dateB = b.date?.toDate ? b.date.toDate() : new Date(b.date);
                return dateB - dateA;
            });
            
            purchases.forEach(p => {
                const div = document.createElement('div');
                div.className = 'history-card';
                
                const isDelivered = p.keyStatus === 'delivered' && p.key && p.key !== 'PENDING';
                const statusText = isDelivered ? '✅ DELIVERED' : '⏳ PENDING';
                const statusColor = isDelivered ? 'status-delivered' : 'status-pending';
                
                let keyHtml = '';
                if(isDelivered) {
                    keyHtml = `<div class="key-box">
                                <span class="key-text-delivered" id="key-${p.id}">${p.key}</span>
                                <button class="btn btn-primary" style="width:auto; padding:0 15px; height:35px; font-size:11px;" onclick="copyKey('key-${p.id}')"><i class="fas fa-copy"></i> COPY</button>
                               </div>
                               <button class="btn" onclick="window.open('${p.link || '#'}', '_blank')" style="width:100%; height:40px; font-size:12px; border-color:var(--neon-cyan); color:var(--neon-cyan); background:transparent;"><i class="fas fa-download"></i> ACCESS FILES</button>`;
                } else {
                    keyHtml = `<div class="key-box">
                                <span class="key-text-pending"><i class="fas fa-clock"></i> Key Pending - Admin will deliver within 24 hours</span>
                               </div>
                               <button class="btn btn-pending" onclick="window.open('${document.getElementById('global-telegram-btn')?.href || '#'}', '_blank')" style="width:100%; height:40px; font-size:12px;"><i class="fab fa-telegram"></i> CONTACT ADMIN FOR KEY</button>`;
                }
                
                div.innerHTML = `<div style="margin-bottom:5px;"><strong style="font-size:16px;">${p.panelName}</strong> <span style="font-size:12px; color:var(--text-muted);">(${p.label || p.plan})</span></div>
                    <div style="font-size:13px; color:var(--text-muted); margin-bottom:5px;">Amount: <span style="color:#fff; font-weight:600;">₹${p.price}</span></div>
                    <div class="${statusColor}" style="margin-bottom:5px;">${statusText}</div>
                    ${keyHtml}`;
                container.appendChild(div);
            });
        }, (error) => {
            console.error("Live History error: ", error);
            container.innerHTML = '<div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>Failed to connect live server.</p></div>';
        });
    }

    async function loadProfile() {
        if(!currentUser) return;
        const userSnap = await get(ref(db, `users/${currentUser.uid}`));
        const purchaseSnap = await get(ref(db, `purchases/${currentUser.uid}`));
        let count = 0, spent = 0;
        if(purchaseSnap.exists()) purchaseSnap.forEach(c => { count++; spent += c.val().price || 0; });
        document.getElementById('prof-email').innerText = currentUser.email;
        document.getElementById('prof-bal').innerText = userSnap.val()?.balance || 0;
        document.getElementById('prof-purchases').innerText = count;
        document.getElementById('prof-spent').innerText = spent.toFixed(2);
        if(userSnap.val()?.createdAt) {
            const date = userSnap.val().createdAt.toDate ? userSnap.val().createdAt.toDate() : new Date(userSnap.val().createdAt);
            document.getElementById('prof-date').innerText = date.toLocaleDateString();
        }
    }

    async function loadEarningsData() {
        if(!currentUser) return { refCount: 0, activeCount: 0, totalDeposited: 0 };
        
        let refCount = 0;
        let activeCount = 0;
        let totalDeposited = 0;
        let mapping = {};

        const usersSnap = await get(ref(db, 'users'));
        const paymentsSnap = await get(ref(db, 'payments'));

        if(usersSnap.exists()) {
            usersSnap.forEach(userChild => {
                const userDataObj = userChild.val();
                if(userDataObj.referredBy === currentUser.uid) {
                    refCount++;
                    mapping[userChild.key] = {
                        email: userDataObj.email || 'Hidden User',
                        uid: userChild.key,
                        totalDep: 0
                    };
                }
            });
        }

        if(paymentsSnap.exists()) {
            paymentsSnap.forEach(payChild => {
                const pay = payChild.val();
                if(pay.status === 'approved' || pay.status === 'success') {
                    if(mapping[pay.uid]) {
                        const amt = parseFloat(pay.amount || 0);
                        mapping[pay.uid].totalDep += amt;
                        totalDeposited += amt;
                    }
                }
            });
        }

        Object.values(mapping).forEach(user => {
            if(user.totalDep > 0) activeCount++;
        });

        globalReferralMapping = mapping;
        return { refCount, activeCount, totalDeposited };
    }

    async function loadEarnings() {
        if(!currentUser) return;
        const currentDomain = window.location.origin + window.location.pathname;
        document.getElementById('ref-link-text').innerText = `${currentDomain}?ref=${currentUser.uid}`;

        const data = await loadEarningsData();
        const commission = data.totalDeposited * 0.02;
        
        document.getElementById('earn-ref-count').innerText = data.refCount;
        document.getElementById('earn-active-count').innerText = data.activeCount;
        document.getElementById('earn-total-dep').innerText = data.totalDeposited.toFixed(2);
        document.getElementById('earn-total-comm').innerText = commission.toFixed(2);
    }

    function initAutomatedLifecycleCommissions() {
        onValue(ref(db, 'payments'), (snap) => {
            if(!snap.exists()) return;
            snap.forEach(payChild => {
                const payId = payChild.key;
                const pay = payChild.val();
                
                if((pay.status === 'approved' || pay.status === 'success') && pay.uid && pay.amount > 0 && !pay.commissionDisbursed) {
                    get(ref(db, `users/${pay.uid}`)).then(userSnap => {
                        if(userSnap.exists()) {
                            const referrerUid = userSnap.val().referredBy;
                            if(referrerUid) {
                                const commissionPayout = parseFloat(pay.amount) * 0.02;
                                
                                runTransaction(ref(db, `users/${referrerUid}/balance`), (currentBal) => {
                                    return (currentBal || 0) + commissionPayout;
                                }).then(() => {
                                    set(ref(db, `payments/${payId}/commissionDisbursed`), true);
                                    
                                    if(currentUser && currentUser.uid === referrerUid) {
                                        showToast(`Instant 2% commission of ₹${commissionPayout.toFixed(2)} added to your wallet!`, 'success');
                                        loadEarnings();
                                    }
                                }).catch(err => console.error("Commission dispersion error: ", err));
                            } else {
                                set(ref(db, `payments/${payId}/commissionDisbursed`), true);
                            }
                        }
                    });
                }
            });
        });
    }

    let autoScroll;
    function initPromotions() {
        onValue(ref(db, 'promotions'), (snap) => {
            const container = document.getElementById('promo-container');
            const promos = [];
            if(snap.exists()) snap.forEach(c => { if(c.val().status === true || c.val().status === 'true') promos.push(c.val()); });
            if(promos.length === 0) { container.classList.add('hidden'); return; }
            container.classList.remove('hidden');
            container.innerHTML = '';
            promos.forEach(p => {
                container.innerHTML += `<div class="promo-card glass" onclick="window.open('${p.link || '#'}', '_blank')">
                    ${p.image ? `<img src="${p.image}" alt="${p.title}">` : '<div style="background:#111;height:100%;"></div>'}
                    <div class="promo-overlay"><div class="promo-title">${p.title || 'Special Offer'}</div></div>
                </div>`;
            });
            if(autoScroll) clearInterval(autoScroll);
            autoScroll = setInterval(() => {
                if(container.scrollLeft + container.clientWidth >= container.scrollWidth - 10) container.scrollTo({ left: 0, behavior: 'smooth' });
                else container.scrollBy({ left: 300, behavior: 'smooth' });
            }, 4000);
        });
    }

    function fetchPanels() {
        onValue(ref(db, 'panels'), (snapshot) => {
            const skeleton = document.getElementById('skeleton-container');
            const panelsContainer = document.getElementById('panels-container');
            if(skeleton) skeleton.classList.add('hidden');
            if(panelsContainer) panelsContainer.classList.remove('hidden');
            if(panelsContainer) panelsContainer.innerHTML = '';
            
            if (!snapshot.exists()) {
                if(panelsContainer) panelsContainer.innerHTML = '<div class="empty-state"><i class="fas fa-box"></i><p>No panels available</p></div>';
                return;
            }
            
            snapshot.forEach((child) => {
                const panelId = child.key;
                const p = child.val();
                if(!p || p.status !== 'active') return;
                
                let featuresHtml = (p.description || 'Premium Tool').split(/\n|-/).filter(f => f.trim()).slice(0,4)
                    .map(f => `<span class="feature-chip"><i class="fas fa-bolt"></i> ${f.trim()}</span>`).join('');
                
                let plansHtml = '';
                if(p.plans && Object.keys(p.plans).length > 0) {
                    plansHtml = `<select class="plan-select" id="plan-${panelId}">`;
                    Object.entries(p.plans).forEach(([key, plan]) => {
                        plansHtml += `<option value='${JSON.stringify({key, label: plan.label, price: plan.price})}'>${plan.label || key} - ₹${plan.price}</option>`;
                    });
                    plansHtml += `</select>`;
                }
                
                let videoHtml = '';
                const videoUrl = p.video || p.youtube || '';
                const embedCode = getVideoEmbedCode(videoUrl);
                if(embedCode) videoHtml = `<div class="video-container">${embedCode}</div>`;
                else videoHtml = `<div class="video-container"><div class="video-fallback"><i class="fas fa-video-slash"></i><span>Video Unavailable</span></div></div>`;
                
                const card = document.createElement('div');
                card.className = 'panel-card';
                card.setAttribute('data-search', `${p.name} ${p.description || ''}`);
                card.innerHTML = `${videoHtml}<div class="panel-info"><div class="panel-title">${p.name}</div><div class="features-list">${featuresHtml || '<span class="feature-chip">Premium Quality</span>'}</div>${plansHtml}<button class="btn btn-purchase" onclick="handlePurchase('${panelId}', '${p.name.replace(/'/g, "\\'")}', '${p.link || ''}')">PURCHASE NOW</button></div>`;
                panelsContainer.appendChild(card);
            });
            
            const searchInput = document.getElementById('search-input');
            const emptyState = document.getElementById('search-empty');
            if(searchInput) {
                searchInput.oninput = () => {
                    const term = searchInput.value.toLowerCase();
                    let visible = 0;
                    document.querySelectorAll('.panel-card').forEach(card => {
                        const match = card.dataset.search?.toLowerCase().includes(term);
                        card.style.display = match ? 'flex' : 'none';
                        if(match) visible++;
                    });
                    if(emptyState) emptyState.classList.toggle('hidden', visible > 0);
                };
            }
        });
    }

    window.currentCheckout = {};
    window.handlePurchase = (panelId, panelName, link) => {
        const select = document.getElementById(`plan-${panelId}`);
        if(!select) return showToast('No plan selected', 'error');
        const plan = JSON.parse(select.value);
        window.currentCheckout = { panelId, panelName, link, planKey: plan.key, label: plan.label, price: plan.price };
        document.getElementById('chk-panel-name').innerText = panelName;
        document.getElementById('chk-plan-label').innerText = plan.label;
        document.getElementById('chk-orig-price').innerText = plan.price;
        document.getElementById('chk-final-price').innerText = plan.price;
        document.getElementById('chk-strike-price').classList.add('hidden');
        document.getElementById('modal-checkout').classList.add('active');
    };
    
    document.getElementById('confirm-purchase-btn').onclick = async () => {
        if(!currentUser) return;
        const price = window.currentCheckout.price;
        if(userData.balance < price) return showToast(`Need ₹${price}`, "error");
        try {
            const result = await runTransaction(ref(db, `users/${currentUser.uid}/balance`), (bal) => bal >= price ? bal - price : undefined);
            if(result.committed) {
                await push(ref(db, `purchases/${currentUser.uid}`), {
                    panelId: window.currentCheckout.panelId,
                    panelName: window.currentCheckout.panelName,
                    plan: window.currentCheckout.planKey,
                    label: window.currentCheckout.label,
                    price: price,
                    key: "PENDING",
                    keyStatus: "pending",
                    link: window.currentCheckout.link,
                    date: serverTimestamp()
                });
                document.getElementById('modal-checkout').classList.remove('active');
                document.getElementById('modal-success').classList.add('active');
                showToast("Purchase successful! Key pending from admin.");
            } else showToast("Insufficient balance", "error");
        } catch(e) { showToast("Error: " + e.message, "error"); }
    };

    onAuthStateChanged(auth, (user) => {
        const loader = document.getElementById('loader');
        const authScreen = document.getElementById('auth-screen');
        const mainApp = document.getElementById('main-app');
        const dripIntro = document.getElementById('drip-intro-overlay');
        
        if(user) {
            currentUser = user;
            // Set User Email in Navbar
            document.getElementById('user-email-display').innerText = user.email;
            
            if(authScreen) authScreen.style.display = 'none';
            
            if(loader) loader.style.display = 'none';
            if(dripIntro) {
                dripIntro.classList.remove('hidden');
                setTimeout(() => {
                    dripIntro.style.opacity = '0';
                    dripIntro.style.visibility = 'hidden';
                    if(mainApp) mainApp.style.display = 'block';
                    setTimeout(() => dripIntro.remove(), 600);
                }, 3500);
            } else {
                if(mainApp) mainApp.style.display = 'block';
            }
            
            onValue(ref(db, `users/${user.uid}/balance`), (snap) => {
                const balance = snap.val() || 0;
                userData.balance = balance;
                
                const bigBalSpan = document.getElementById('big-wallet-balance');
                if(bigBalSpan) bigBalSpan.innerText = balance.toFixed(2);
            });
            
            fetchPanels();
            initPromotions();
            initAutomatedLifecycleCommissions();
            navigate('dashboard');
        } else {
            if(historyListenerUnsubscribe) {
                historyListenerUnsubscribe();
                historyListenerUnsubscribe = null;
            }
            currentUser = null;
            if(authScreen) authScreen.style.display = 'flex';
            if(mainApp) mainApp.style.display = 'none';
            if(loader) loader.style.display = 'none';
            if(dripIntro) dripIntro.classList.add('hidden');
        }
    });

    (function() {
        let hue = 0;
        setInterval(() => {
            const r = Math.sin(hue) * 127 + 128;
            const g = Math.sin(hue + 2.094) * 127 + 128;
            const b = Math.sin(hue + 4.188) * 127 + 128;
            document.documentElement.style.setProperty('--neon-cyan', `rgb(${Math.floor(r)}, ${Math.floor(g)}, ${Math.floor(b)})`);
            hue += 0.105;
            if(hue > Math.PI * 2) hue -= Math.PI * 2;
        }, 1000);
    })();
