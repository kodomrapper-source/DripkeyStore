<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
<title>DRIP KEY STORE</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
        :root {
            --bg-color: #050508;
            --card-bg: rgba(15, 18, 25, 0.45);
            --card-border: rgba(0, 240, 255, 0.12);
            --neon-cyan: #00f0ff;
            --neon-cyan-dim: rgba(0, 240, 255, 0.2);
            --neon-purple: #bc13fe;
            --neon-pink: #ff007f;
            --text-main: #ffffff;
            --text-muted: #a0a5b5;
            --error: #ff2a5f;
            --success: #00ff66;
            --warning: #ffb800;
            --wa-color: #25D366;
            --fb-color: #1877F2;
            --share-color: #00f0ff;
            --tg-color: #0088cc;
            --nav-height: 70px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }

        body {
            background: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
            background-image: radial-gradient(circle at 10% 20%, rgba(188, 19, 254, 0.08) 0%, transparent 40%),
                              radial-gradient(circle at 90% 80%, rgba(0, 240, 255, 0.08) 0%, transparent 40%);
            background-attachment: fixed;
        }

        .hidden { display: none !important; }
        
        .glass {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: 16px;
        }

        /* --- DRIPSTORE INTRO ANIMATION STYLE --- */
        #drip-intro-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #020204;
            z-index: 100000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.6s ease-in-out, visibility 0.6s;
        }

        .drip-intro-box {
            text-align: center;
        }

        .intro-title {
            font-size: 52px;
            font-weight: 900;
            letter-spacing: 8px;
            background: linear-gradient(90deg, #ff007f, #bc13fe, #00f0ff, #ff007f);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            margin-bottom: 5px;
            opacity: 0;
            transform: scale(0.9);
            position: relative;
            animation: fadeInScale 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards 0.3s, flowColors 3s linear infinite;
        }

        .intro-title::after {
            content: '';
            position: absolute;
            top: 0; left: -150%;
            width: 50%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
            transform: skewX(-25deg);
            animation: laserRun 1.8s ease-in-out infinite 1.2s;
        }

        .intro-line-glow {
            width: 0px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--neon-purple), var(--neon-pink), transparent);
            margin: 15px auto;
            box-shadow: 0 0 15px var(--neon-purple), 0 0 30px var(--neon-pink);
            animation: expandLine 1.5s cubic-bezier(0.7, 0, 0.3, 1) forwards 0.5s;
        }

        .intro-subtitle {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 8px;
            color: var(--neon-cyan);
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
            text-transform: uppercase;
            opacity: 0;
            animation: fadeInSub 1s ease-out forwards 1.4s;
        }

        @keyframes fadeInScale { to { opacity: 1; transform: scale(1); } }
        @keyframes flowColors { 0% { background-position: 0% center; } 100% { background-position: 200% center; } }
        @keyframes laserRun { 0% { left: -150%; } 50% { left: 150%; } 100% { left: 150%; } }
        @keyframes expandLine { to { width: 250px; } }
        @keyframes fadeInSub { to { opacity: 1; } }

        /* SKELETONS */
        .skeleton-card {
            background: rgba(20,24,34,0.4);
            border-radius: 20px;
            overflow: hidden;
            animation: pulse 1.5s ease-in-out infinite;
            border: 1px solid rgba(255,255,255,0.05);
        }
        @keyframes pulse { 0%,100%{opacity:0.6;}50%{opacity:1;} }
        .skeleton-video { height: 200px; background: rgba(0,0,0,0.4); }
        .skeleton-title { height: 24px; width: 70%; margin: 15px; background: rgba(255,255,255,0.05); border-radius: 8px; }
        .skeleton-chip { height: 28px; width: 80px; display: inline-block; margin: 5px; background: rgba(255,255,255,0.05); border-radius: 20px; }
        .skeleton-btn { height: 48px; margin: 15px; background: rgba(255,255,255,0.05); border-radius: 12px; }

        /* BUTTONS */
        .btn {
            background: transparent; color: var(--neon-cyan); border: 1px solid var(--neon-cyan);
            padding: 12px 20px; border-radius: 12px; font-weight: 600; cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); width: 100%;
            display: inline-flex; justify-content: center; align-items: center; gap: 8px;
            font-size: 13px; height: 48px;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .btn:hover { background: var(--neon-cyan-dim); box-shadow: 0 0 15px rgba(0, 240, 255, 0.3); transform: translateY(-2px); }
        .btn:active { transform: translateY(0); }
        .btn-primary { background: var(--neon-cyan); color: #000; font-weight: 800; border: none; }
        .btn-primary:hover { background: #00d2e0; box-shadow: 0 0 20px rgba(0, 240, 255, 0.5); }
        
        .btn-purchase {
            background: linear-gradient(90deg, var(--neon-purple), #0073ff);
            border: none; color: white; font-weight: 800;
            box-shadow: 0 0 15px rgba(188, 19, 254, 0.3);
        }
        .btn-purchase:hover {
            box-shadow: 0 0 25px rgba(188, 19, 254, 0.6), 0 0 10px rgba(0, 115, 255, 0.4);
            transform: translateY(-2px);
        }
        .btn-pending {
            background: rgba(255,184,0,0.1);
            border: 1px solid var(--warning);
            color: var(--warning);
        }
        .btn-pending:hover { background: rgba(255,184,0,0.2); }

        .input-group { margin-bottom: 15px; }
        .input-group input {
            width: 100%; padding: 0 18px; height: 50px; background: rgba(0,0,0,0.4);
            border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; color: white;
            outline: none; transition: all 0.3s;
        }
        .input-group input:focus { border-color: var(--neon-cyan); box-shadow: 0 0 10px rgba(0, 240, 255, 0.2); }

        #loader {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #050508; z-index: 100001;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }
        .spinner {
            width: 50px; height: 50px; border: 4px solid rgba(0,240,255,0.1);
            border-top-color: var(--neon-cyan); border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 100% { transform: rotate(360deg); } }

        #toast-container {
            position: fixed; top: 25px; left: 50%; transform: translateX(-50%);
            z-index: 100000; width: 90%; max-width: 400px;
        }
        .toast {
            padding: 14px 20px; border-radius: 12px; color: white; font-weight: 600;
            background: rgba(15, 18, 25, 0.85); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
            border-left: 4px solid var(--neon-cyan);
            animation: slideDown 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            margin-bottom: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            display: flex; align-items: center; gap: 12px;
        }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: translateY(0); } }

        #auth-screen { min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 20px; }
        .auth-card { width: 100%; max-width: 420px; padding: 40px 30px; text-align: center; border-radius: 24px; border: 1px solid rgba(255,255,255,0.08); position: relative; overflow: hidden; }
        .auth-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, var(--neon-purple), var(--neon-cyan)); }
        .auth-card h1 { font-weight: 800; font-size: 28px; margin-bottom: 8px; text-transform: uppercase; }
        .auth-card h1 span { color: var(--neon-cyan); text-shadow: 0 0 10px rgba(0, 240, 255, 0.3); }
        .auth-card p { color: var(--text-muted); font-size: 14px; margin-bottom: 25px; }
        .auth-toggle { margin-top: 20px; font-size: 13px !important; }

        #main-app { display: none; width: 100%; }
        
        /* HEADER NAVBAR & BRANDING LOGO */
        .navbar {
            position: fixed; top: 0; left: 0; width: 100%; height: var(--nav-height);
            display: flex; justify-content: space-between; align-items: center;
            padding: 0 25px; z-index: 1000;
            background: rgba(5, 5, 8, 0.7);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .nav-left { display: flex; align-items: center; gap: 15px; width: 100%; position: relative; }
        
        .logo-wrapper { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .logo-img { width: 35px; height: 35px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--neon-cyan); box-shadow: 0 0 10px var(--neon-cyan-dim); }
        .logo { font-weight: 800; font-size: 20px; letter-spacing: 0.5px; text-transform: uppercase; }
        .logo span { color: var(--neon-cyan); text-shadow: 0 0 10px rgba(0, 240, 255, 0.3); }

        /* USER EMAIL STYLE IN NAVBAR */
        .user-email-nav {
            font-size: 12px;
            color: var(--text-muted);
            background: rgba(255,255,255,0.05);
            padding: 5px 12px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            margin-left: auto;
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        /* Large Styled Dashboard Wallet Section */
        .big-wallet-box {
            background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(188, 19, 254, 0.15));
            border: 2px solid var(--neon-cyan);
            border-radius: 20px;
            padding: 25px 20px;
            text-align: center;
            margin-top: 20px;
            margin-bottom: 30px;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.25), inset 0 0 15px rgba(0, 240, 255, 0.1);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .big-wallet-box:hover {
            transform: scale(1.02);
            box-shadow: 0 0 35px rgba(0, 240, 255, 0.4);
        }
        .big-wallet-box i {
            font-size: 32px;
            color: var(--neon-cyan);
            margin-bottom: 8px;
            text-shadow: 0 0 15px rgba(0, 240, 255, 0.6);
        }
        .big-wallet-box .wallet-title {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            margin-bottom: 5px;
        }
        .big-wallet-box .wallet-amount {
            font-size: 36px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: 1px;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
        }

        /* --- ONE-TAP DASHBOARD GRID SYSTEM --- */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }
        .dashboard-item {
            background: linear-gradient(135deg, rgba(16, 20, 30, 0.6), rgba(8, 10, 15, 0.8));
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 20px 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }
        .dashboard-item:hover {
            transform: translateY(-4px);
            border-color: var(--neon-cyan);
            box-shadow: 0 8px 25px rgba(0, 240, 255, 0.15);
        }
        .dashboard-item i {
            font-size: 26px;
            background: linear-gradient(45deg, var(--neon-cyan), var(--neon-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .dashboard-item span {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-main);
        }
        .dashboard-item.item-logout:hover {
            border-color: var(--error);
            box-shadow: 0 8px 25px rgba(255, 42, 95, 0.15);
        }
        .dashboard-item.item-logout i {
            background: var(--error);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* BACK TO DASHBOARD MENU BUTTON */
        .back-menu-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            color: var(--text-muted);
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            margin-bottom: 20px;
            text-transform: uppercase;
        }
        .back-menu-btn:hover {
            border-color: var(--neon-cyan);
            color: var(--neon-cyan);
            background: var(--neon-cyan-dim);
        }

        /* MAIN APP STYLING */
        .page-content { padding: calc(var(--nav-height) + 20px) 20px 40px; max-width: 1200px; margin: 0 auto; min-height: 100vh; animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
        .page-title { font-size: 24px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
        .page-title span { color: var(--neon-purple); text-shadow: 0 0 15px rgba(188, 19, 254, 0.3); }

        .search-container { position: relative; flex: 1; min-width: 280px; max-width: 400px; }
        .search-container input { width: 100%; height: 46px; padding: 0 20px 0 48px; border-radius: 30px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: #fff; outline: none; transition: 0.3s; }
        .search-container input:focus { border-color: var(--neon-cyan); background: rgba(0,0,0,0.2); }
        .search-container i.fa-search { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }

        .promo-slider { display: flex; overflow-x: auto; gap: 15px; margin-bottom: 35px; scroll-snap-type: x mandatory; padding-bottom: 5px; }
        .promo-slider::-webkit-scrollbar { display: none; }
        .promo-card { flex: 0 0 85%; max-width: 450px; height: 160px; position: relative; border-radius: 16px; overflow: hidden; scroll-snap-align: center; cursor: pointer; border: 1px solid rgba(255,255,255,0.05); }
        @media (min-width: 768px) { .promo-card { flex: 0 0 45%; } .dashboard-grid { grid-template-columns: repeat(3, 1fr); } }
        .promo-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
        .promo-card:hover img { transform: scale(1.04); }
        .promo-overlay { position: absolute; bottom: 0; left: 0; width: 100%; padding: 40px 15px 15px; background: linear-gradient(transparent, rgba(5,5,8,0.95)); }
        .promo-title { color: white; font-weight: 700; font-size: 15px; }

        .panel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
        .panel-card {
            background: linear-gradient(145deg, rgba(16, 20, 30, 0.7), rgba(8, 10, 15, 0.85));
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px; overflow: hidden; display: flex; flex-direction: column;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .panel-card:hover { transform: translateY(-6px); border-color: rgba(0, 240, 255, 0.3); box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(0, 240, 255, 0.05); }

        .video-container { position: relative; width: 100%; padding-bottom: 56.25%; background: #000; overflow: hidden; }
        .video-container iframe, .video-container video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
        .video-fallback { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(12,15,22,0.9); color: var(--text-muted); }
        .video-fallback i { font-size: 40px; margin-bottom: 10px; color: rgba(255,255,255,0.15); }

        .panel-info { padding: 22px; display: flex; flex-direction: column; flex: 1; }
        .panel-title { font-size: 19px; font-weight: 800; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.3px; }
        .features-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
        .feature-chip { background: rgba(0,240,255,0.04); border: 1px solid rgba(0,240,255,0.15); color: var(--neon-cyan); padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 600; }
        .plan-select { width: 100%; padding: 0 15px; height: 48px; background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; color: white; margin-bottom: 18px; cursor: pointer; outline: none; font-weight: 500; }
        .plan-select:focus { border-color: var(--neon-purple); }
        .panel-info .btn { margin-top: auto; }

        .payment-settings-card { padding: 35px 25px; text-align: center; max-width: 550px; margin: 0 auto; border-radius: 24px; }
        .qr-image-container { width: 180px; height: 180px; margin: 15px auto; background: rgba(0,0,0,0.3); border-radius: 16px; border: 2px dashed rgba(0, 240, 255, 0.3); display: flex; align-items: center; justify-content: center; overflow: hidden; }
        .qr-image-container img { width: 100%; height: 100%; object-fit: cover; }
        .upi-box { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 12px; border: 1px solid rgba(0,240,255,0.2); margin: 20px 0; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; color: var(--neon-cyan); transition: 0.2s; }
        .upi-box:hover { background: rgba(0,240,255,0.05); }

        .history-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .history-card { padding: 22px; background: var(--card-bg); border-radius: 18px; border-left: 4px solid var(--neon-purple); border-top: 1px solid rgba(255,255,255,0.03); border-right: 1px solid rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.03); }
        .status-pending { color: var(--warning); font-weight: 700; font-size: 13px; text-transform: uppercase; }
        .status-delivered { color: var(--success); font-weight: 700; font-size: 13px; text-transform: uppercase; }
        .key-box { background: rgba(0,0,0,0.4); padding: 12px 15px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin: 15px 0; border: 1px solid rgba(255,255,255,0.05); }
        .key-text-pending { font-size: 13px; color: var(--warning); display: flex; align-items: center; gap: 8px; }
        .key-text-delivered { font-family: monospace; font-size: 15px; color: var(--success); font-weight: bold; letter-spacing: 1px; word-break: break-all; }
        .profile-stat { display: flex; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 14px; }
        .profile-stat:last-child { border: none; }
        .profile-stat span { color: var(--text-muted); display: flex; align-items: center; gap: 10px; }

        /* --- DRIP STYLE EARNINGS 4-GRID --- */
        .earnings-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }
        .earnings-card {
            background: linear-gradient(145deg, rgba(15, 18, 25, 0.7), rgba(5, 6, 10, 0.9));
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 16px 12px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }
        .earnings-card i {
            font-size: 20px;
            color: var(--neon-cyan);
            margin-bottom: 6px;
            text-shadow: 0 0 10px var(--neon-cyan-dim);
        }
        .earnings-card .label {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.3px;
            margin-bottom: 4px;
        }
        .earnings-card .value {
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
        }
        .earnings-card .value.bonus {
            color: var(--success);
            text-shadow: 0 0 10px rgba(0, 255, 102, 0.2);
        }

        /* --- DRIP STYLE REFERRAL LINK & ATTRACTIVE COPY BUTTON (HOT PINK) --- */
        .drip-link-box {
            display: flex;
            flex-direction: column;
            background: rgba(0, 0, 0, 0.6);
            border: 2px dashed var(--card-border);
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 15px;
            align-items: center;
            padding: 12px;
            gap: 12px;
            transition: all 0.3s;
        }
        .drip-link-box:hover {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 12px var(--neon-cyan-dim);
        }
        .drip-link-text {
            width: 100%;
            padding: 5px;
            font-size: 13px;
            color: var(--text-muted);
            text-align: center;
            word-break: break-all;
            white-space: normal;
        }
        .drip-copy-btn {
            background: linear-gradient(90deg, #ff007f, #bc13fe);
            color: #fff;
            border: none;
            width: 100%;
            max-width: 200px;
            height: 40px;
            border-radius: 8px;
